<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Candidate Report</title>

  <style>
    html { font-size: 80%; }

    body {
      font-family: Raleway, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      background: #ffffff;
      color: #252a34;
      padding: 24px;
    }

    .container {
      max-width: 820px;
      margin: 0 auto;
    }

    .header {
      margin-bottom: 36px;
    }

    .header img {
      max-height: 72px;
      margin-bottom: 24px;
      display: block;
    }

    .header h2 {
      font-size: 26px;
      margin: 0 0 12px;
    }

    .header p {
      margin: 4px 0;
      font-size: 14px;
    }

    .gauge-row {
      display: flex;
      gap: 16px;
      margin: 32px 0;
    }

    .card {
      flex: 1;
      background: #ffffff;
      border: 2px solid #b58cff;
      border-radius: 12px;
      padding: 14px;
    }

    .label {
      font-size: 13px;
      margin-bottom: 6px;
    }

    .score-text {
      font-size: 22px;
      font-weight: 700;
      color: #b58cff;
      margin-bottom: 8px;
    }

    .bar {
      width: 100%;
      height: 10px;
      background: #252a34;
      border-radius: 6px;
      overflow: hidden;
    }

    .bar span {
      display: block;
      height: 100%;
      background: #b58cff;
    }

    .section {
      margin-top: 28px;
    }

    .section h3 {
      font-size: 18px;
      margin-bottom: 8px;
    }

    .kv {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .kv li {
      margin-bottom: 6px;
      line-height: 1.4;
      word-break: break-word;
    }

    .kv strong {
      white-space: nowrap;
    }

    .summary-box {
      margin-top: 10px;
      padding: 12px;
      border: 1px solid #e2e2e8;
      border-radius: 10px;
      background: #fafafa;
    }

    .muted {
      opacity: 0.75;
      font-size: 13px;
    }
  </style>
</head>

<body>
  <div class="container">

    <div class="header">
      {{#if logo_src}}<img src="{{logo_src}}" alt="AlphaSource Logo" />{{/if}}
      <h2>Candidate Report</h2>
      <p><strong>Name:</strong> {{name}}</p>
      <p><strong>Email:</strong> {{email}}</p>
      <p><strong>Company:</strong> {{company_name}}</p>
      <p><strong>Role:</strong> {{role_name}}</p>
    </div>

    <div class="gauge-row">
      <div class="card">
        <div class="label">Resume Score</div>
        <div class="score-text">{{resume_score}}%</div>
        <div class="bar"><span style="width: {{resume_score}}%;"></span></div>
      </div>

      <div class="card">
        <div class="label">Interview Score</div>
        <div class="score-text">{{interview_score}}%</div>
        <div class="bar"><span style="width: {{interview_score}}%;"></span></div>
      </div>

      <div class="card">
        <div class="label">Overall Score</div>
        <div class="score-text">{{overall_score}}%</div>
        <div class="bar"><span style="width: {{overall_score}}%;"></span></div>
      </div>
    </div>

    <div class="section">
      <h3>Resume Analysis</h3>
      <ul class="kv">
        <li><strong>Experience:</strong> {{resume_breakdown.experience}}%</li>
        <li><strong>Skills:</strong> {{resume_breakdown.skills}}%</li>
        <li><strong>Education:</strong> {{resume_breakdown.education}}%</li>
      </ul>

      <div class="summary-box">
        {{#if resume_summary}}
          {{resume_summary}}
        {{else}}
          <span class="muted">Summary not available.</span>
        {{/if}}
      </div>
    </div>

    <div class="section">
      <h3>Interview Analysis</h3>
      <ul class="kv">
        <li><strong>Confidence:</strong> {{interview_breakdown.confidence}}%</li>
        <li><strong>Clarity:</strong> {{interview_breakdown.clarity}}%</li>
<li><strong>Engagement:</strong> {{interview_breakdown.engagement}}%</li>
      </ul>

      <div class="summary-box">
        {{#if interview_summary}}
          {{interview_summary}}
        {{else}}
          {{#if analysis.summary}}
            {{analysis.summary}}
          {{else}}
            <span class="muted">Summary not available.</span>
          {{/if}}
        {{/if}}
      </div>
    </div>

    <div class="section">
      <h3>Unanswered Candidate Questions</h3>
      {{#if unanswered_candidate_questions.length}}
        <ul class="kv">
          {{#each unanswered_candidate_questions}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{else}}
        <p class="muted">None reported.</p>
      {{/if}}
    </div>

  </div>
</body>
</html>
