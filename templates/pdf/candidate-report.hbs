<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>alphaScreen Candidate Review Brief</title>
<style>
{{{font_css}}}
@page { size:A4 landscape; }
* { box-sizing:border-box; }
body { margin:0; font-family:Raleway,Arial,sans-serif; font-size:11px; line-height:1.35; background:#F6F8FC; color:#0D1645; }
h1,h2,h3,p { margin:0; } h1 { font-size:27px; line-height:1.2; margin:7px 0; } h2 { font-size:11px; text-transform:uppercase; letter-spacing:.65px; margin-bottom:8px; } h3 { font-size:11px; margin-bottom:8px; }
p,li,.badge { overflow-wrap:anywhere; white-space:pre-wrap; }
.hero { background:#0D1645; color:white; border-radius:15px; padding:14px 20px; display:flex; justify-content:space-between; gap:24px; margin-bottom:14px; break-inside:avoid; }
.identity { min-width:0; flex:1; } .eyebrow { font-size:9px; letter-spacing:1px; text-transform:uppercase; } .metadata { margin-top:6px; font-size:9px; opacity:.8; }
.hero-score { flex:0 0 245px; } .total { font-size:32px; font-weight:700; margin:3px 0; } .total small { font-size:15px; font-weight:400; }
.analysis-grid { display:grid; grid-template-columns:2.6fr 1fr; gap:14px; align-items:start; }
.primary-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; align-items:start; }
.card { background:#fff; border-radius:14px; padding:14px; margin-bottom:9px; break-inside:avoid; }
.primary-grid .card { break-inside:auto; }
.metric { margin-bottom:12px; break-inside:avoid; } .metric-head { display:flex; justify-content:space-between; gap:8px; color:#64718D; margin-bottom:5px; } .metric-head strong { color:#0D1645; }
.bar { background:#EDF0F7; height:5px; border-radius:6px; overflow:hidden; } .bar span { display:block; height:100%; border-radius:6px; }
.summary { color:#56637F; } .summary-label { color:#0D1645; font-weight:700; } .muted { color:#64718D; font-size:10px; }
.pill { background:#F0EAFF; padding:8px 11px; border-radius:10px; margin:8px 0; font-weight:600; } .risk { background:#E9FAF3; }
.signal-section + .signal-section { border-top:1px solid #EDF0F7; margin-top:15px; padding-top:15px; }
.advanced-grid { display:grid; grid-template-columns:1fr 1fr; column-gap:22px; } .advanced-grid .metric { margin-bottom:6px; }
.questions { background:#FFF6DC; padding:10px 14px; border-radius:14px; break-inside:avoid; } ul { padding-left:16px; margin:0; } li + li { margin-top:8px; }
.evidence-page { break-before:page; }
.masthead { display:flex; gap:20px; justify-content:space-between; align-items:center; margin-bottom:16px; break-inside:avoid; }
.brand { display:flex; align-items:center; gap:8px; font-size:19px; font-weight:600; margin-bottom:7px; } .brand img { width:24px; height:24px; }
.masthead h1 { font-size:20px; } .masthead-right { text-align:right; font-size:9px; color:#64718D; }
.evidence-summary { background:#F0EAFF; } .badges { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:10px; margin:0 0 16px; break-inside:avoid; }
.badge-label { font-size:9px; color:#64718D; margin-bottom:5px; } .badge { font-size:10px; background:white; padding:9px; border-radius:10px; border:1px solid #E5EAF4; }
.limitations { float:right; width:31%; break-inside:auto; } .evidence { width:67%; } .evidence .card h3 { color:#64718D; font-size:9px; text-transform:uppercase; letter-spacing:.5px; }
.evidence-page:after { content:""; display:block; clear:both; }
.synthetic { color:#AD6E00; font-weight:600; margin:6px 0; } .hero .synthetic { color:#FFE2A2; }
.patent-notice { font-size:9px; opacity:.8; margin-top:7px; }
</style></head><body>
<header class="hero">
<div class="identity"><div class="eyebrow">{{#if logo_src}}<img src="{{logo_src}}" alt="" style="width:16px;height:16px;vertical-align:middle;background:white;border-radius:50%;margin-right:5px">{{/if}}alphaScreen / Candidate review brief</div><h1>{{name}}</h1><p>{{role_name}} · {{company_name}}</p><p class="muted" style="color:#D1D8ED">{{email}}</p><p class="metadata">{{status}} · {{date_label}} · {{attempt_label}}</p></div>
<div class="hero-score"><div class="eyebrow">Overall score</div><div class="total">{{#if (hasScore overall_score)}}{{scoreBarWidth overall_score}} <small>/ 100</small>{{else}}Not assessed{{/if}}</div><p>Resume {{scoreText resume_score}} · Interview {{scoreText interview_score}}</p><p class="patent-notice">alphaScreen technology — Patent Pending</p>{{#if synthetic_demo}}<p class="synthetic">SYNTHETIC DEMO · Illustrative scores</p>{{/if}}</div>
</header>
<div class="analysis-grid"><div><div class="primary-grid">
<section class="card"><h2>Resume analysis</h2>{{#each resume_rows}}<div class="metric"><div class="metric-head"><span>{{label}}</span><strong>{{scoreText score}}</strong></div><div class="bar">{{#if (hasScore score)}}<span style="width:{{scoreBarWidth score}}%;background:{{color}}"></span>{{/if}}</div></div>{{/each}}<p class="summary"><span class="summary-label">Summary: </span>{{#if resume_summary}}{{resume_summary}}{{else}}No resume summary available.{{/if}}</p></section>
<section class="card"><h2>Interview analysis</h2>{{#each interview_rows}}<div class="metric"><div class="metric-head"><span>{{label}}</span><strong>{{scoreText score}}</strong></div><div class="bar">{{#if (hasScore score)}}<span style="width:{{scoreBarWidth score}}%;background:{{color}}"></span>{{/if}}</div></div>{{/each}}<p class="summary"><span class="summary-label">Summary: </span>{{#if interview_summary}}{{interview_summary}}{{else}}No interview summary available.{{/if}}</p></section>
</div>{{#if has_advanced}}<section class="card"><h2>Advanced interview analysis</h2><div class="advanced-grid">{{#each advanced_rows}}<div class="metric"><div class="metric-head"><span>{{label}}</span><strong>{{scoreText score}}</strong></div><div class="bar">{{#if (hasScore score)}}<span style="width:{{scoreBarWidth score}}%;background:{{color}}"></span>{{/if}}</div></div>{{/each}}</div></section>{{/if}}</div>
<aside class="card"><h2>Signals &amp; conditions</h2><div class="signal-section"><h3>Evaluation reliability</h3><div class="pill">{{#if (hasScore interview_breakdown.evidence_strength)}}{{scoreText interview_breakdown.evidence_strength}}{{else}}Not assessed{{/if}}</div>{{#if reliability_note}}<p class="summary">{{reliability_note}}</p>{{else}}<p class="muted">Strength of the available interview evidence, not certainty about future performance.</p>{{/if}}</div><div class="signal-section"><h3>AI-aided interview risk</h3><div class="pill risk">{{risk_label}}</div>{{#if interview_breakdown.ai_aided_risk_reason}}<p class="summary">{{interview_breakdown.ai_aided_risk_reason}}</p>{{/if}}<p class="muted" style="margin-top:9px">A follow-up signal, not proof of AI use or a hiring conclusion.</p></div>{{#if synthetic_demo}}<p class="synthetic">All signals are authored display examples. No real audio/video was analyzed.</p>{{/if}}</aside></div>
<section class="questions"><h2>Unanswered questions</h2>{{#if unanswered_candidate_questions.length}}<ul>{{#each unanswered_candidate_questions}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p class="muted">No unanswered questions captured.</p>{{/if}}</section>
{{#if has_advanced}}<section class="evidence-page">
<header class="masthead"><div><div class="brand">{{#if logo_src}}<img src="{{logo_src}}" alt="">{{/if}}alphaScreen</div><h1>{{name}}</h1><p class="muted">{{role_name}} · {{company_name}}</p></div><div class="masthead-right"><div class="eyebrow">Evidence &amp; limitations</div><p>{{status}} · {{date_label}} · {{attempt_label}}</p>{{#if synthetic_demo}}<p class="synthetic">SYNTHETIC EXAMPLE</p>{{/if}}</div></header>
<section class="card evidence-summary"><h2>Evidence summary</h2><p class="summary">{{#if advanced.evidence_summary}}{{advanced.evidence_summary}}{{else}}Advanced evidence summary not available for this attempt.{{/if}}</p></section>
<div class="badges">{{#each badges}}<div><div class="badge-label">{{label}}</div><div class="badge">{{value}}</div></div>{{/each}}</div>
<aside class="card limitations"><h2>Limitations</h2>{{#if advanced.limitations.length}}<ul class="summary">{{#each advanced.limitations}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p class="muted">No analysis limitations supplied. This does not mean the evidence is complete.</p>{{/if}}{{#if advanced.risk.reason}}<div class="signal-section"><h3>Integrity risk context</h3><p class="summary">{{advanced.risk.reason}}</p></div>{{/if}}<div class="signal-section"><h3>Reviewer note</h3><p class="muted">Scores and signals support a human review of available evidence. They do not make a hiring decision.</p></div></aside>
<div class="evidence">{{#each advanced.evidence}}<article class="card"><h3>Evidence</h3><p class="summary">{{this}}</p></article>{{else}}<article class="card"><h2>Evidence</h2><p class="muted">Advanced evidence not available for this attempt.</p></article>{{/each}}</div>
</section>{{/if}}</body></html>
